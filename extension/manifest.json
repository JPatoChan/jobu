{
  "manifest_version": 3,
  "name": "Jobu — Job Application Autofill",
  "short_name": "Jobu",
  "version": "1.2.0",
  "description": "Scan and autofill job applications, step through multi-page forms, submit, and track every job you apply to.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Jobu",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/shared/schema.js", "src/shared/vault.js", "src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jobu@jpatochan.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "contextMenus", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/shared/schema.js",
        "src/shared/results.js",
        "src/content/classifier.js",
        "src/content/dom.js",
        "src/content/autofill.js",
        "src/content/navigate.js",
        "src/content/job.js",
        "src/content/account.js",
        "src/content/ui.js",
        "src/content/main.js"
      ]
    }
  ],
  "commands": {
    "autofill": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Autofill the job application on this page"
    },
    "next-page": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Go to the next page of the application and autofill it"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Show or hide the Jobu panel"
    },
    "next-empty-field": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Go to the next field Jobu left empty"
    },
    "submit": {
      "description": "Submit the application (asks first unless confirmation is off)"
    }
  }
}
